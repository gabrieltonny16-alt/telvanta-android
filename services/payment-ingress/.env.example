# Server-only PostgreSQL connection. Never put this in Android or a browser.
DATABASE_URL=postgres://postgres:[DB_PASSWORD]@[DB_HOST]:5432/postgres?sslmode=require

# Redis Cluster connection. Keep credentials in the deployment secret manager.
REDIS_CLUSTER_ADDRS=[REDIS_NODE_1]:6379,[REDIS_NODE_2]:6379,[REDIS_NODE_3]:6379
REDIS_USERNAME=
REDIS_PASSWORD=[REDIS_PASSWORD]
REDIS_TLS=true
HTTP_ADDR=:8080

# Authenticated Android notification/SMS relay (HMAC-SHA256).
SMS_INGRESS_HMAC_SECRET=[LONG_RANDOM_SECRET]

# Required: exact Safaricom-confirmed source CIDRs, comma-separated.
# Do not guess these values. The service refuses to start without this allowlist.
DARAJA_ALLOWED_CIDRS=[SAFARICOM_CONFIRMED_CIDR]
