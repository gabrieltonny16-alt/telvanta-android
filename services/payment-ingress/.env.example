# Use the Supabase Postgres connection string (server-side only).
# Never put DATABASE_URL or Redis credentials in the Android app or browser.
DATABASE_URL=postgres://postgres:[DB_PASSWORD]@[DB_HOST]:5432/postgres?sslmode=require
REDIS_URL=rediss://default:[REDIS_PASSWORD]@[REDIS_HOST]:6379
HTTP_ADDR=:8080

# For Android/ConnectPulse SMS relay: HMAC-SHA256 over
# shortcode + newline + exact raw SMS body, lowercase hex in X-Bingwa-SMS-Signature.
SMS_INGRESS_HMAC_SECRET=replace-with-a-long-random-secret

# Optional Daraja source IP CIDRs. Leave empty only behind a trusted HTTPS edge
# that rate-limits the endpoint and blocks direct origin access.
DARAJA_ALLOWED_CIDRS=
