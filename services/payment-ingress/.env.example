# Server-only PostgreSQL connection. Never put this in Android or a browser.
DATABASE_URL=postgres://postgres:[DB_PASSWORD]@[DB_HOST]:5432/postgres?sslmode=require

# Redis Cluster connection. Keep credentials in the deployment secret manager.
REDIS_CLUSTER_ADDRS=[REDIS_NODE_1]:6379,[REDIS_NODE_2]:6379,[REDIS_NODE_3]:6379
REDIS_USERNAME=
REDIS_PASSWORD=[REDIS_PASSWORD]
REDIS_TLS=true
HTTP_ADDR=:8080

# Required: generate at least 32 random bytes and encode as URL-safe Base64 (no padding)
# or hex (64 characters). Put the exact callback URL into Safaricom's C2B registration.
# This secret is server-only: never put it in Android, a browser, or public logs.
DARAJA_CALLBACK_PATH_TOKEN=[HIGH_ENTROPY_URL_SAFE_TOKEN]

# Optional extra network restriction. Populate only with CIDRs confirmed by Safaricom.
# Do not guess these values. If set, the service rejects peers outside the list.
DARAJA_ALLOWED_CIDRS=

# Authenticated Android notification/SMS relay (HMAC-SHA256).
SMS_INGRESS_HMAC_SECRET=[LONG_RANDOM_SECRET]
